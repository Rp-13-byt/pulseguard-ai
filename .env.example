# ==============================================================================
# PulseGuard AI — Environment Configuration
# ==============================================================================

# Server Ports
API_PORT=4000
WEB_PORT=5173
NODE_ENV=development

# Confluent Cloud Kafka Settings
# Leave empty for offline high-fidelity simulator mode
CONFLUENT_BOOTSTRAP_SERVER=
CONFLUENT_KAFKA_API_KEY=
CONFLUENT_KAFKA_API_SECRET=

# Confluent Schema Registry Settings
CONFLUENT_SCHEMA_REGISTRY_URL=
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=

# Confluent Cloud Apache Flink
CONFLUENT_FLINK_COMPUTE_POOL_ID=
CONFLUENT_FLINK_PRINCIPAL=

# Operational PostgreSQL (Source DB for Debezium CDC V2)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retentiondb
POSTGRES_USER=confluent_cdc
POSTGRES_PASSWORD=confluent_cdc_password
POSTGRES_SSL=false

# Anthropic Claude API (For AI Model Inference / Fallback)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional Zendesk Integration
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Outbound Action Webhook (Optional CRM / Slack Integration)
ACTION_WEBHOOK_URL=
